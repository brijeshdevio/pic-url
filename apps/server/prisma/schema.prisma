generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String?      @unique
  name         String?
  passwordHash String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  projects Project[]

  @@index([email])
}

model Project {
  id         String        @id @default(cuid())
  name       String
  tokenHash  String        @unique
  revoked    Boolean       @default(false)
  expiredAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())
  status     ProjectStatus @default(active)
  usedCount  Int           @default(0)
  userId     String

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  images Image[]

  @@unique([userId, name])
  @@index([userId, name])
}

enum ProjectStatus {
  active
  disabled
  revoked
  expired
}

model Image {
  id        String    @id @default(cuid())
  slug      String    @unique
  storageId String    @unique
  name      String
  mimeType  String
  size      Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([slug])
}